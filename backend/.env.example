# Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Storage Mode: mongo | sqlite | auto
# - mongo:  MongoDB required. App refuses to start if Atlas is unreachable.
# - auto:   (default in dev) Uses MongoDB when available, SQLite otherwise.
# - In production (NODE_ENV=production) this defaults to "mongo".
# Set DB_MODE=auto in Vercel env vars ONLY if you want SQLite fallback in prod.
DB_MODE=auto

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/pulse_app?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/pulse_app?retryWrites=true&w=majority
DB_NAME=pulse_app

# Initial Setup Admin (used by npm run admin:setup)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password

# Google Gemini API (Optional)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
