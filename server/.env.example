# Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/pulse_app?retryWrites=true&w=majority

# Initial Setup Admin (used by npm run admin:setup)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password

# Google Gemini API (Optional)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
