# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/project_mentor
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API (Strictly Server-Side)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# GitHub Integration (Optional Webhook Secret / Personal Access Token for rate limits)
GITHUB_API_TOKEN=your_github_token_optional
