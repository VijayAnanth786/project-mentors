{
  "name": "project-mentor-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ProjectMentor - College Student Project Monitoring Platform (MERN)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "server:dev": "npm run backend:dev",
    "client:dev": "npm run frontend:dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "db:seed": "npm --prefix backend run db:seed",
    "admin:setup": "npm --prefix backend run admin:setup",
    "test": "npm --prefix backend run test",
    "test:api": "npm --prefix backend run test:api",
    "test:mongo": "node backend/test-mongo.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.7",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
